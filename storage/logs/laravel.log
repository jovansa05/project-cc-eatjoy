    \"<span class=sf-dump-key>role</span>\" => \"<span class=sf-dump-str title=\"2 characters\">ai</span>\"
    \"<span class=sf-dump-key>message</span>\" => \"<span class=sf-dump-str title=\"167 characters\">Untuk turun 5kg dalam 1 bulan, perlu defisit 500-750 kalori/hari. Sarankan: 1) Makan 1500 kalori/hari 2) Olahraga 30 menit/hari 3) Minum 2L air 4) Tidur cukup 7-8 jam.</span>\"
